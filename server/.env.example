# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache (Use 'mongo' & 'redis' when running inside Docker Compose)
MONGO_URI=mongodb://localhost:27017/verifai
REDIS_URL=redis://localhost:6379

# JWT Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Email Services (Brevo / Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@verifai.dev
BREVO_SMTP_USER=
BREVO_API_KEY=
BREVO_SENDER_NAME=VerifAI

# Execution Engine & AI
JUDGE0_API_URL=http://localhost:2358
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
BADGE_SCORE_THRESHOLD=80
